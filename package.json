{
  "name": "campuskit",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "nest build --all",
    "typecheck": "tsc -p tsconfig.check.json",
    "start:dev": "nest start --watch",
    "infra": "docker compose up -d postgres mongo rabbitmq",
    "stack": "docker compose up --build",
    "seed": "docker compose run --rm --build identity node dist/apps/identity/main.js seed",
    "lint": "oxlint --type-aware apps/ libs/",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "test": "vitest run --passWithNoTests",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "mongoose": "^9.11.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@rspack/core": "^2.2.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "{apps,libs}/**/*.ts": [
      "oxlint --type-aware",
      "prettier --write"
    ],
    "web/src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  }
}
